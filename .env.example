# ==================================================================
# OBSŁUGA FORMULARZA WYCENY
#
# Skopiuj ten plik do `.env` i ustaw JEDNEGO dostawcę. Bez konfiguracji
# formularz działa w trybie `mock`: waliduje dane i pokazuje ekran
# podziękowania, ale niczego nie wysyła.
#
# Zmienne z prefiksem VITE_ trafiają do kodu przeglądarki, więc NIE
# wpisuj tu haseł ani kluczy prywatnych. Klucze publiczne poniżej są do
# tego przeznaczone.
# ==================================================================

# mock | formsubmit | web3forms | formspree | netlify | custom
VITE_FORM_PROVIDER=mock


# ------------------------------------------------------------------
# 1) FormSubmit  https://formsubmit.co     ZALECANE, jeśli chcesz zdjęcia
# ------------------------------------------------------------------
# Darmowe, bez zakładania konta. Obsługuje załączniki (suma plików w
# jednym zgłoszeniu do 10 MB; strona zmniejsza zdjęcia przed wysyłką,
# więc limit nie powinien przeszkadzać).
#
# Uruchomienie:
#  1. ustaw VITE_FORM_PROVIDER=formsubmit,
#  2. wpisz poniżej swój adres e-mail,
#  3. wyślij pierwsze testowe zgłoszenie i kliknij link aktywacyjny,
#     który przyjdzie na ten adres,
#  4. opcjonalnie podmień adres na losowy ciąg z panelu FormSubmit,
#     żeby nie publikować maila w kodzie strony.
VITE_FORMSUBMIT_TARGET=twoj@email.pl


# ------------------------------------------------------------------
# 2) Web3Forms  https://web3forms.com
# ------------------------------------------------------------------
# Darmowy klucz dostępu wysyłany mailem, bez zakładania konta.
# Uwaga: załączniki są funkcją planu PRO, dlatego w planie darmowym
# do wiadomości trafia tylko liczba zdjęć, bez samych plików.
VITE_WEB3FORMS_KEY=


# ------------------------------------------------------------------
# 3) Formspree  https://formspree.io
# ------------------------------------------------------------------
# Plan darmowy: 50 zgłoszeń miesięcznie, bez przesyłania plików
# (przesyłanie plików zaczyna się od planu płatnego).
# Wpisz identyfikator formularza z adresu https://formspree.io/f/XXXXXXX
VITE_FORMSPREE_ID=


# ------------------------------------------------------------------
# 4) Netlify Forms (tylko przy hostingu na Netlify)
# ------------------------------------------------------------------
# Wymaga statycznego formularza w index.html, instrukcja w README.
VITE_NETLIFY_FORM_NAME=wycena


# ------------------------------------------------------------------
# 5) Własny endpoint: funkcja serverless, webhook, n8n, Make, CRM
# ------------------------------------------------------------------
# Otrzyma multipart/form-data z polami zgłoszenia i plikami.
VITE_FORM_ENDPOINT=


# ------------------------------------------------------------------
# Wymuszenie zachowania załączników niezależnie od domyślnych ustawień
# dostawcy: true = wysyłaj pliki, false = wysyłaj tylko ich liczbę.
# ------------------------------------------------------------------
# VITE_FORM_ATTACHMENTS=true


# ==================================================================
# PANEL TREŚCI (/admin)
# ==================================================================
# Hasło do panelu przechowujemy jako skrót SHA-256, nie jako tekst.
# Domyślne hasło to `okna-admin-2026`. Żeby je zmienić, policz skrót
# nowego hasła i wpisz go poniżej (albo ustaw jako zmienną repozytorium
# w GitHub Actions):
#
#   node -e "console.log(require('crypto').createHash('sha256').update('twoje-haslo').digest('hex'))"
#
# Uwaga: to nie jest zabezpieczenie kryptograficzne, tylko zamek na
# furtce. Publikacja zmian i tak wymaga tokenu GitHuba, którego nie ma
# w kodzie strony.
VITE_ADMIN_PASS_HASH=

# Repozytorium, do którego panel zapisuje zmiany.
VITE_GH_OWNER=kacperhac890
VITE_GH_REPO=mycie-okien
VITE_GH_BRANCH=main
